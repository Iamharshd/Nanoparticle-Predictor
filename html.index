<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NanoFormulate AI - Inverse & Forward Nanoparticle Design Platform</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <style>
    :root {
      --bg-main: #0b1120;
      --card-bg: #111827;
      --card-border: #1f2937;
      --accent-cyan: #06b6d4;
      --accent-emerald: #10b981;
      --accent-violet: #8b5cf6;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
    }
    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    input[type=range] {
      accent-color: var(--accent-cyan);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #111827;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #374151;
      border-radius: 3px;
    }
    .tab-btn.active {
      background-color: #1e293b;
      color: #38bdf8;
      border-bottom: 2px solid #38bdf8;
    }
    .badge-glow {
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.25);
    }
  </style>
</head>
<body class="min-h-screen text-slate-100 p-3 md:p-6 custom-scrollbar">

  <!-- TOP HEADER -->
  <header class="max-w-7xl mx-auto mb-6 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl backdrop-blur-md">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3" stroke-width="2"/>
              <circle cx="19" cy="5" r="2" stroke-width="2"/>
              <circle cx="5" cy="19" r="2" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v6m-3-3h6M17.5 6.5l-4 4m-7 7l4-4"/>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 via-sky-300 to-emerald-400 bg-clip-text text-transparent">
              NanoFormulate AI
            </h1>
            <p class="text-xs md:text-sm text-slate-400 font-medium">
              Multi-Target Inverse Design & Forward AI Predictor for Nanoparticle Formulations
            </p>
          </div>
        </div>
      </div>

      <!-- System Meta Tags & Presets -->
      <div class="flex flex-wrap items-center gap-2">
        <div class="px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs text-slate-300">
          <span class="text-cyan-400 font-semibold">Platform:</span> Compritol 888 ATO / PLGA Solid Lipid NPs
        </div>
        <div class="px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs text-slate-300">
          <span class="text-emerald-400 font-semibold">Dataset:</span> 120 Latin Hypercube Runs
        </div>
        <div class="px-3 py-1.5 rounded-lg bg-cyan-950/70 border border-cyan-800 text-xs text-cyan-300 font-semibold badge-glow">
          Inverse &amp; Forward AI Platform
        </div>
      </div>
    </div>

    <!-- NAVIGATION TABS -->
    <div class="flex items-center gap-2 mt-5 border-t border-slate-800 pt-3 overflow-x-auto custom-scrollbar">
      <button onclick="switchTab('forward')" id="tab-forward" class="tab-btn active px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-300 hover:text-white">
        <span>⚡</span> Forward AI Predictor
      </button>
      <button onclick="switchTab('inverse')" id="tab-inverse" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-400 hover:text-white">
        <span>🎯</span> Inverse Formulation Designer
      </button>
      <button onclick="switchTab('analytics')" id="tab-analytics" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-400 hover:text-white">
        <span>📊</span> Model Validation & Benchmarks
      </button>
      <button onclick="switchTab('dataset')" id="tab-dataset" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-400 hover:text-white">
        <span>🔬</span> 120 Formulations Dataset
      </button>
      <button onclick="switchTab('concept')" id="tab-concept" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-400 hover:text-white">
        <span>📑</span> Project Concept & Lab SOP
      </button>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto space-y-6">

    <!-- TAB 1: FORWARD AI PREDICTOR -->
    <section id="view-forward" class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT: FORMULATION CONTROLS -->
      <div class="lg:col-span-5 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <h2 class="text-lg font-bold text-slate-100 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
              Formulation Inputs (X)
            </h2>
            <p class="text-xs text-slate-400">Tune independent synthesis parameters</p>
          </div>
          <div class="relative">
            <select id="preset-selector" onchange="applyPreset(this.value)" class="bg-slate-800 border border-slate-700 text-xs text-cyan-300 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-cyan-500">
              <option value="">Load Demo Preset...</option>
              <option value="small">Small Nano-Carrier (~130 nm)</option>
              <option value="highEE">High EE Payload (~85% EE)</option>
              <option value="stable">Brain Vector (Lecithin, -32 mV)</option>
              <option value="balanced">Balanced Baseline (~195 nm)</option>
            </select>
          </div>
        </div>

        <!-- 1. Surfactant System -->
        <div class="space-y-1.5">
          <label class="text-xs font-semibold uppercase tracking-wider text-slate-400">Surfactant System</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" onclick="setSurfactant('Poloxamer 188')" id="btn-surf-1" class="surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-cyan-950/80 border-cyan-500 text-cyan-300">
              Poloxamer 188
            </button>
            <button type="button" onclick="setSurfactant('Tween 80')" id="btn-surf-2" class="surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200">
              Tween 80
            </button>
            <button type="button" onclick="setSurfactant('Poloxamer 188 + Lecithin')" id="btn-surf-3" class="surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200">
              Poloxamer + Lecithin
            </button>
          </div>
        </div>

        <!-- 2. Lipid Concentration Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-300">Glyceryl Behenate / Lipid Matrix</span>
            <span id="val-lipid" class="text-cyan-400 font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700">3.0 % w/v</span>
          </div>
          <input type="range" id="input-lipid" min="1.0" max="5.0" step="0.1" value="3.0" oninput="onParamChange()" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>1.0%</span>
            <span>Compritol 888 ATO</span>
            <span>5.0%</span>
          </div>
        </div>

        <!-- 3. Surfactant Concentration Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-300">Surfactant Concentration</span>
            <span id="val-surf" class="text-cyan-400 font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700">1.8 % w/v</span>
          </div>
          <input type="range" id="input-surf" min="0.5" max="3.0" step="0.1" value="1.8" oninput="onParamChange()" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>0.5% (Aqueous phase)</span>
            <span>3.0%</span>
          </div>
        </div>

        <!-- 4. Drug Loading Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-300">Drug Loading Ratio</span>
            <span id="val-drug" class="text-cyan-400 font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700">8.0 % of lipid</span>
          </div>
          <input type="range" id="input-drug" min="2.0" max="15.0" step="0.5" value="8.0" oninput="onParamChange()" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>2.0% (BCS Class II Model)</span>
            <span>15.0%</span>
          </div>
        </div>

        <!-- 5. Homogenization Speed Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-300">Homogenization Speed</span>
            <span id="val-rpm" class="text-cyan-400 font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700">14,000 rpm</span>
          </div>
          <input type="range" id="input-rpm" min="8000" max="20000" step="500" value="14000" oninput="onParamChange()" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>8,000 rpm (High-shear)</span>
            <span>20,000 rpm</span>
          </div>
        </div>

        <!-- 6. Sonication Time Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-slate-300">Probe Sonication Time</span>
            <span id="val-son" class="text-cyan-400 font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700">6.0 min</span>
          </div>
          <input type="range" id="input-son" min="2.0" max="10.0" step="0.5" value="6.0" oninput="onParamChange()" class="w-full h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>2.0 min (Cavitation)</span>
            <span>10.0 min</span>
          </div>
        </div>

        <!-- LIVE BATCH MASS CALCULATOR (20 mL Batch Standard) -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3.5 space-y-2">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
            <span>Batch Stoichiometry (20 mL Volume)</span>
            <span class="text-emerald-400 font-mono">100% Solubilized</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Lipid Matrix Mass:</span>
              <span id="calc-lipid-mass" class="text-emerald-400 font-bold font-mono text-sm">600.0 mg</span>
            </div>
            <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
              <span class="text-slate-400 block text-[11px]">Drug Mass Added:</span>
              <span id="calc-drug-mass" class="text-emerald-400 font-bold font-mono text-sm">48.0 mg</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: AI PREDICTED CQAs (CRITICAL QUALITY ATTRIBUTES) -->
      <div class="lg:col-span-7 space-y-5">

        <!-- TOP 5 METRIC CARDS -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">

          <!-- Size Card -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg hover:border-cyan-500/50 transition">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span class="font-semibold">Particle Size</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800">DLS</span>
            </div>
            <div class="flex items-baseline gap-1 my-1">
              <span id="out-size" class="text-3xl font-extrabold text-white">194</span>
              <span class="text-xs text-slate-400 font-semibold">nm</span>
            </div>
            <div id="badge-size" class="text-[11px] font-medium text-cyan-300 mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Optimal EPR Target
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-size" class="bg-cyan-500 h-full rounded-full transition-all duration-300" style="width: 50%;"></div>
            </div>
          </div>

          <!-- PDI Card -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg hover:border-emerald-500/50 transition">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span class="font-semibold">Polydispersity (PDI)</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">Quality</span>
            </div>
            <div class="flex items-baseline gap-1 my-1">
              <span id="out-pdi" class="text-3xl font-extrabold text-white">0.294</span>
            </div>
            <div id="badge-pdi" class="text-[11px] font-medium text-emerald-400 mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Monodisperse Uniform
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-pdi" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 45%;"></div>
            </div>
          </div>

          <!-- Zeta Potential Card -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg hover:border-violet-500/50 transition">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span class="font-semibold">Zeta Potential</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-violet-950 text-violet-400 border border-violet-800">Stability</span>
            </div>
            <div class="flex items-baseline gap-1 my-1">
              <span id="out-zeta" class="text-3xl font-extrabold text-white">-20.4</span>
              <span class="text-xs text-slate-400 font-semibold">mV</span>
            </div>
            <div id="badge-zeta" class="text-[11px] font-medium text-violet-300 mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span> Moderate Colloid
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-zeta" class="bg-violet-500 h-full rounded-full transition-all duration-300" style="width: 60%;"></div>
            </div>
          </div>

          <!-- Encapsulation Efficiency (EE %) Card -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg hover:border-amber-500/50 transition">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span class="font-semibold">Encapsulation (EE)</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800">Yield</span>
            </div>
            <div class="flex items-baseline gap-1 my-1">
              <span id="out-ee" class="text-3xl font-extrabold text-white">77.8</span>
              <span class="text-xs text-slate-400 font-semibold">%</span>
            </div>
            <div id="badge-ee" class="text-[11px] font-medium text-amber-300 mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> High Entrapment
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-ee" class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: 78%;"></div>
            </div>
          </div>

          <!-- Loading Capacity Card -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg hover:border-sky-500/50 transition col-span-2 md:col-span-2">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span class="font-semibold">Loading Capacity (LC)</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-950 text-sky-400 border border-sky-800">Payload %</span>
            </div>
            <div class="flex items-baseline gap-1 my-1">
              <span id="out-lc" class="text-3xl font-extrabold text-white">5.86</span>
              <span class="text-xs text-slate-400 font-semibold">%</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-1">
              Formula: <span class="text-sky-300 font-mono">Drug Entrapped / (Lipid + Drug Entrapped) × 100</span>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-lc" class="bg-sky-500 h-full rounded-full transition-all duration-300" style="width: 58%;"></div>
            </div>
          </div>
        </div>

        <!-- RADAR & PHYSICOCHEMICAL PROFILE -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
            <div>
              <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                <span>🕸️</span> Multi-Property Colloid Radar Profile
              </h3>
              <p class="text-xs text-slate-400">Normalized comparison against dataset boundaries (Min - Mean - Max)</p>
            </div>
            <div class="flex items-center gap-3 text-xs">
              <span class="flex items-center gap-1.5 text-slate-400"><span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span> Dataset Mean</span>
              <span class="flex items-center gap-1.5 text-cyan-300 font-semibold"><span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span> Current Formulation</span>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
            <!-- SVG Radar Canvas -->
            <div class="md:col-span-6 flex justify-center">
              <svg id="radar-svg" width="280" height="260" viewBox="0 0 300 300" class="overflow-visible">
                <!-- Dynamically drawn by JS -->
              </svg>
            </div>

            <!-- Physicochemical Trend Guide -->
            <div class="md:col-span-6 space-y-2.5 text-xs">
              <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800">
                <span class="font-bold text-cyan-400 block mb-0.5">🔹 Particle Size Dynamics</span>
                <span class="text-slate-300">Homogenization rpm (shear stress) and probe sonication (cavitation shockwaves) break molten lipid droplets into sub-200nm nanospheres. Higher lipid mass expands core volume.</span>
              </div>
              <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800">
                <span class="font-bold text-amber-400 block mb-0.5">🔹 Entrapment Efficiency Plateau</span>
                <span class="text-slate-300">Drug EE peaks when lipid matrix volume provides sufficient lipophilic core space. Excessive drug loading (&gt;12%) triggers expulsion during Compritol crystallization upon cooling.</span>
              </div>
              <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800">
                <span class="font-bold text-violet-400 block mb-0.5">🔹 Colloid Charge &amp; Stability</span>
                <span class="text-slate-300">Poloxamer 188 provides steric PEO hindrance; Poloxamer + Lecithin generates high negative zeta potential (&lt; -30 mV) via phosphatidic acid ionization, preventing Ostwald ripening.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- TAB 2: INVERSE FORMULATION DESIGNER -->
    <section id="view-inverse" class="hidden space-y-6">
      <!-- INVERSE TARGET INPUTS HEADER CARD -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <div class="max-w-3xl mb-5">
          <span class="px-2.5 py-1 rounded-md bg-cyan-950 text-cyan-300 border border-cyan-800 text-xs font-semibold">
            Inverse AI Architecture
          </span>
          <h2 class="text-xl md:text-2xl font-extrabold text-white mt-2">
            Target-to-Formulation Inverse Design Engine
          </h2>
          <p class="text-xs md:text-sm text-slate-400 mt-1">
            Specify your desired nanoparticle performance goals (Target Particle Size, EE%, PDI, Surfactant). The AI optimization engine will search the formulation parameter space and compute the candidate recipes predicted to achieve your targets.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 p-4 bg-slate-950/70 rounded-xl border border-slate-800">
          <!-- Target Size -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-xs">
              <span class="font-semibold text-slate-300">Target Particle Size</span>
              <span id="target-size-val" class="font-bold text-cyan-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">150 nm</span>
            </div>
            <input type="range" id="inv-size" min="110" max="300" step="5" value="150" oninput="updateTargetLabel('size', this.value)" class="w-full h-1.5 bg-slate-800 rounded-lg cursor-pointer">
            <span class="text-[11px] text-slate-500">Allowed range: 110 - 300 nm</span>
          </div>

          <!-- Target EE -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-xs">
              <span class="font-semibold text-slate-300">Target Encapsulation (EE)</span>
              <span id="target-ee-val" class="font-bold text-emerald-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">80.0 %</span>
            </div>
            <input type="range" id="inv-ee" min="62" max="86" step="0.5" value="80.0" oninput="updateTargetLabel('ee', this.value)" class="w-full h-1.5 bg-slate-800 rounded-lg cursor-pointer">
            <span class="text-[11px] text-slate-500">Allowed range: 62% - 86%</span>
          </div>

          <!-- Target Zeta Potential -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-xs">
              <span class="font-semibold text-slate-300">Target Zeta Potential</span>
              <span id="target-zeta-val" class="font-bold text-violet-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">-25.0 mV</span>
            </div>
            <input type="range" id="inv-zeta" min="-34.0" max="-10.0" step="0.5" value="-25.0" oninput="updateTargetLabel('zeta', this.value)" class="w-full h-1.5 bg-slate-800 rounded-lg cursor-pointer">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-500">-34 to -10 mV</span>
              <label class="flex items-center gap-1 cursor-pointer text-slate-400 hover:text-slate-200">
                <input type="checkbox" id="inv-zeta-enable" checked onchange="toggleZetaTarget(this.checked)" class="rounded bg-slate-800 border-slate-700 text-violet-500 focus:ring-0">
                <span class="text-[10px] text-violet-300 font-medium">Active Target</span>
              </label>
            </div>
          </div>

          <!-- Desired PDI Threshold -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-xs">
              <span class="font-semibold text-slate-300">Max Acceptable PDI</span>
              <span id="target-pdi-val" class="font-bold text-amber-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">&le; 0.25</span>
            </div>
            <input type="range" id="inv-pdi" min="0.20" max="0.38" step="0.01" value="0.25" oninput="updateTargetLabel('pdi', this.value)" class="w-full h-1.5 bg-slate-800 rounded-lg cursor-pointer">
            <span class="text-[11px] text-slate-500">Monodispersity limit</span>
          </div>

          <!-- Surfactant Preference -->
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-300 block">Surfactant Filter</label>
            <select id="inv-surf-pref" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-2.5 py-2 focus:ring-1 focus:ring-cyan-500">
              <option value="Any">Any Surfactant System (Recommended)</option>
              <option value="Poloxamer 188">Poloxamer 188 Only</option>
              <option value="Tween 80">Tween 80 Only</option>
              <option value="Poloxamer 188 + Lecithin">Poloxamer 188 + Lecithin Only</option>
            </select>
            <span class="text-[11px] text-slate-500">Select bio-compatible surfactant</span>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <button onclick="runInverseOptimization()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs tracking-wide shadow-lg shadow-cyan-500/30 transition flex items-center gap-2">
              <svg class="w-4 h-4 animate-spin-reverse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
