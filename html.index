    <!-- TAB 4: 120 FORMULATIONS DATASET EXPLORER -->
    <section id="view-dataset" class="hidden space-y-5">
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-xl font-extrabold text-white">Experimental Formulations Dataset (n=120)</h2>
            <p class="text-xs text-slate-400">5-factor Latin Hypercube synthesis space with hot homogenization &amp; probe sonication</p>
          </div>

          <!-- Filters & Actions -->
          <div class="flex flex-wrap items-center gap-2">
            <input type="text" id="dataset-search" oninput="filterDatasetTable()" placeholder="Search ID (e.g. SLN-042)..." class="bg-slate-800 border border-slate-700 text-xs rounded-lg px-3 py-1.5 text-slate-200 placeholder-slate-500 focus:ring-1 focus:ring-cyan-500">
            <select id="dataset-surf-filter" onchange="filterDatasetTable()" class="bg-slate-800 border border-slate-700 text-xs text-slate-300 rounded-lg px-2.5 py-1.5">
              <option value="All">All Surfactants (120)</option>
