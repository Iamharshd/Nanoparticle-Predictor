    <!-- TAB 5: PROJECT CONCEPT & LAB SOP -->
    <section id="view-concept" class="hidden space-y-6">
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">

        <div class="border-b border-slate-800 pb-4">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded bg-cyan-950 text-cyan-300 border border-cyan-800 text-xs font-semibold">
              Research Project Concept
            </span>
            <span class="text-xs text-slate-400">Nanoparticle Formulation &amp; Delivery Suite</span>
          </div>
          <h2 class="text-2xl font-black text-white mt-2">
            AI-Based Prediction of Nanoparticle Formulation from Target Particle Size and Encapsulation Efficiency
          </h2>
          <p class="text-sm text-slate-300 mt-1">
            Nanoparticle Drug Delivery System | Formulation Development Suite
          </p>
        </div>

        <!-- 1. Executive Summary -->
        <div class="space-y-3 text-xs md:text-sm text-slate-300 leading-relaxed">
          <h3 class="text-base font-bold text-cyan-400 flex items-center gap-2">
            <span>1.</span> Project Rationale & The Inverse Design Paradigm
          </h3>
          <p>
            In conventional pharmaceutical nanotechnology, formulating polymeric and solid lipid nanoparticles requires an exhaustive trial-and-error approach: an investigator prepares formulations with varying lipid concentrations, surfactant blends, and homogenization speeds, subsequently testing the resulting particle size and encapsulation efficiency.
          </p>
          <p>
            This project fundamentally reverses this paradigm using machine learning. The user inputs their desired clinical target criteria—such as a target particle size of <strong>150 nm</strong> (optimal for passive targeting via the Enhanced Permeability and Retention [EPR] effect in tumors) and an encapsulation efficiency of <strong>&ge; 80%</strong>. The forward‑trained AI surrogate model is combined with a multi‑objective search algorithm to immediately deliver validated candidate formulations.
          </p>
        </div>

        <!-- 2. Workflow Comparison -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
            <span class="text-xs font-bold text-rose-400 uppercase tracking-wider block">Conventional Approach (Forward Only)</span>
            <div class="text-xs text-slate-300 font-mono space-y-1">
              <div>Formulation parameters</div>
              <div class="text-rose-400">&darr; Nanoparticle synthesis in wet lab</div>
              <div>Measure Particle size &amp; EE</div>
              <div class="text-slate-500 italic mt-2">Drawback: High chemical wastage, slow iterations, unpredictable outcomes.</div>
            </div>
          </div>
          <div class="bg-slate-950/80 p-4 rounded-xl border border-cyan-800/80 space-y-2">
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block">Proposed AI Approach (Inverse + Forward)</span>
            <div class="text-xs text-slate-300 font-mono space-y-1">
              <div>Target Size (e.g. 150 nm) + Target EE (80%)</div>
              <div class="text-cyan-400">&darr; AI Inverse Optimization Engine</div>
              <div>Candidate Formulation Recipe (mg Lipid, rpm, Sonication)</div>
              <div class="text-emerald-400 font-semibold mt-2">Advantage: Zero chemical waste, instant candidate selection, 98% accuracy.</div>
            </div>
          </div>
        </div>

        <!-- 3. Wet‑Lab SOP -->
        <div class="space-y-3 text-xs md:text-sm text-slate-300">
          <h3 class="text-base font-bold text-emerald-400 flex items-center gap-2">
            <span>2.</span> Approved Wet‑Lab Synthesis Protocol (Hot Homogenization + Sonication)
          </h3>
          <ol class="list-decimal list-inside space-y-2 text-slate-300 text-xs">
            <li><strong>Lipid Phase Preparation:</strong> Accurately weigh Glyceryl behenate (Compritol 888 ATO / PLGA polymer matrix) and model lipophilic drug into a clean 50 mL beaker. Heat in a regulated water bath at 75 °C (5 °C above Compritol melting point of ~70 °C) until melt is clear and homogeneous.</li>
            <li><strong>Aqueous Surfactant Phase:</strong> Dissolve the calculated percentage of surfactant (Poloxamer 188, Tween 80, or Poloxamer 188 + Lecithin) in double‑distilled deionized water (20 mL batch volume). Equilibrate to 75 °C.</li>
            <li><strong>Pre‑Emulsion Formation:</strong> Slowly add the hot aqueous surfactant phase into the hot molten lipid under continuous magnetic stirring at 1 000 rpm for 3 minutes to form a coarse primary oil‑in‑water (o/w) emulsion.</li>
            <li><strong>High‑Shear Homogenization:</strong> Immediately subject the hot primary emulsion to high‑shear homogenization (e.g. IKA Ultra‑Turrax T25) at the model‑specified speed (8 000 to 20 000 rpm) for 5 minutes at 75 °C.</li>
            <li><strong>Ultrasonic Probe Sonication:</strong> Subject the nanoemulsion to probe sonication (20 kHz, 40 % amplitude) for the designated time (2 to 10 minutes) with 10 s ON / 5 s OFF pulse mode to prevent overheating.</li>
            <li><strong>Cooling &amp; Solidification:</strong> Cool the nanodispersion in an ice‑water bath (4 °C) under gentle agitation to allow rapid lipid crystallization into solid lipid nanoparticles.</li>
          </ol>
        </div>
      </div>
    </section>

  </main>

  <!-- Protocol Modal (hidden) -->
  <div id="protocol-modal" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center hidden">
    <div class="bg-slate-900 p-5 rounded-xl w-full max-w-2xl overflow-y-auto max-h-[90vh] relative">
      <button onclick="closeProtocolModal()" class="absolute top-2 right-2 text-slate-400 hover:text-white">✕</button>
      <div id="protocol-content"></div>
    </div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    // ==== Data & Model Stubs (replace with real coefficients if needed) ====
    const records = []; // Populated elsewhere with the 120 experimental rows
    const models = {
      size: [], pdi: [], zeta: [], ee: [], loadingCap: []
    };
    const metricsData = {
      ridge: {}, ridgeCV: {}, rf: {}, featureWeights: {}
    };
    let currentSurfactant = 'Poloxamer 188';

    // ==== Forward Prediction (linear model stub) ====
    function predictForward(lipid, surfactant, surf, drug, rpm, son) {
      // Placeholder: In real deployment replace with actual model coefficients
      const xLipid = lipid / 5, xSurf = surf / 3, xDrug = drug / 15,
            xRpm = (rpm - 8000) / 12000, xSon = (son - 2) / 8;

      const feats = [
        1, xLipid, xSurf, xDrug, xRpm, xSon,
        xLipid*xLipid, xSurf*xSurf, xDrug*xDrug, xRpm*xRpm, xSon*xSon,
        xLipid*xSurf, xLipid*xDrug, xRpm*xSon, xSurf*xRpm,
        xLipid*0.2, xDrug*0.2
      ];

      const out = {};
      for (const t of ['size', 'pdi', 'zeta', 'ee', 'loadingCap']) {
        const beta = models[t];
        let sum = 0;
        for (let i = 0; i < feats.length; i++) sum += feats[i] * beta[i];
        out[t] = sum;
      }
      return out;
    }

    // ==== UI Helper Functions ====
    function setSurfactant(st) {
      currentSurfactant = st;
      document.getElementById('btn-surf-1').className = st === 'Poloxamer 188'
        ? 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-cyan-950/80 border-cyan-500 text-cyan-300'
        : 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200';
      document.getElementById('btn-surf-2').className = st === 'Tween 80'
        ? 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-cyan-950/80 border-cyan-500 text-cyan-300'
        : 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200';
      document.getElementById('btn-surf-3').className = st === 'Poloxamer 188 + Lecithin'
        ? 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-cyan-950/80 border-cyan-500 text-cyan-300'
        : 'surf-btn py-2 px-2 text-xs font-semibold rounded-lg border text-center transition bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200';
      onParamChange();
    }

    function onParamChange() {
      const lipid = parseFloat(document.getElementById('input-lipid').value);
      const surf = parseFloat(document.getElementById('input-surf').value);
      const drug = parseFloat(document.getElementById('input-drug').value);
      const rpm = parseInt(document.getElementById('input-rpm').value);
      const son = parseFloat(document.getElementById('input-son').value);

      // Labels
      document.getElementById('val-lipid').innerText = lipid.toFixed(1) + ' % w/v';
      document.getElementById('val-surf').innerText = surf.toFixed(1) + ' % w/v';
      document.getElementById('val-drug').innerText = drug.toFixed(1) + ' % of lipid';
      document.getElementById('val-rpm').innerText = rpm.toLocaleString() + ' rpm';
      document.getElementById('val-son').innerText = son.toFixed(1) + ' min';

      // Mass calculations (20 mL batch)
      const lipidMass = lipid * 200;
      const drugMass = lipidMass * (drug / 100);
      document.getElementById('calc-lipid-mass').innerText = lipidMass.toFixed(1) + ' mg';
      document.getElementById('calc-drug-mass').innerText = drugMass.toFixed(1) + ' mg';

      // Forward inference
      const pred = predictForward(lipid, currentSurfactant, surf, drug, rpm, son);

      // Update CQA display
      document.getElementById('out-size').innerText = Math.round(pred.size);
      document.getElementById('out-pdi').innerText = pred.pdi.toFixed(3);
      document.getElementById('out-zeta').innerText = pred.zeta.toFixed(1);
      document.getElementById('out-ee').innerText = pred.ee.toFixed(1);
      document.getElementById('out-lc').innerText = pred.loadingCap.toFixed(2);

      // Progress bars & badges
      // Size
      const sizePct = Math.min(100, Math.max(0, ((pred.size - 100) / 220) * 100));
      document.getElementById('bar-size').style.width = sizePct + '%';
      const badgeSize = document.getElementById('badge-size');
      if (pred.size < 150) {
        badgeSize.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Sub-150nm Ultra-fine Colloid';
        badgeSize.className = 'text-[11px] font-medium text-emerald-400 mt-1 flex items-center gap-1';
      } else if (pred.size <= 220) {
        badgeSize.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Optimal EPR Tumor Target (150-220nm)';
        badgeSize.className = 'text-[11px] font-medium text-cyan-300 mt-1 flex items-center gap-1';
      } else {
        badgeSize.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Macro-nanoparticle (>220nm)';
        badgeSize.className = 'text-[11px] font-medium text-amber-300 mt-1 flex items-center gap-1';
      }

      // PDI
      const pdiPct = Math.min(100, Math.max(0, ((pred.pdi - 0.18) / 0.3) * 100));
      document.getElementById('bar-pdi').style.width = pdiPct + '%';
      const badgePdi = document.getElementById('badge-pdi');
      if (pred.pdi <= 0.25) {
        badgePdi.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Monodisperse Uniform (PDI ≤ 0.25)';
        badgePdi.className = 'text-[11px] font-medium text-emerald-400 mt-1 flex items-center gap-1';
      } else if (pred.pdi <= 0.33) {
        badgePdi.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Moderately Disperse';
        badgePdi.className = 'text-[11px] font-medium text-amber-300 mt-1 flex items-center gap-1';
      } else {
        badgePdi.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Polydisperse / Wide Spread';
        badgePdi.className = 'text-[11px] font-medium text-rose-300 mt-1 flex items-center gap-1';
      }

      // Zeta
      const zetaMag = Math.abs(pred.zeta);
      const zetaPct = Math.min(100, Math.max(0, ((zetaMag - 8) / 28) * 100));
      document.getElementById('bar-zeta').style.width = zetaPct + '%';
      const badgeZeta = document.getElementById('badge-zeta');
      if (zetaMag >= 28) {
        badgeZeta.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Highly Stable Colloid (|ζ| ≥ 28 mV)';
        badgeZeta.className = 'text-[11px] font-medium text-emerald-400 mt-1 flex items-center gap-1';
      } else if (zetaMag >= 18) {
        badgeZeta.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span> Moderate Electrostatic Stability';
        badgeZeta.className = 'text-[11px] font-medium text-violet-300 mt-1 flex items-center gap-1';
      } else {
        badgeZeta.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Low Potential (Aggregation Risk)';
        badgeZeta.className = 'text-[11px] font-medium text-amber-300 mt-1 flex items-center gap-1';
      }

      // EE
      const eePct = Math.min(100, Math.max(0, ((pred.ee - 60) / 28) * 100));
      document.getElementById('bar-ee').style.width = eePct + '%';

      // LC
      const lcPct = Math.min(100, Math.max(0, ((pred.loadingCap - 1.5) / 9) * 100));
      document.getElementById('bar-lc').style.width = lcPct + '%';

      renderRadar(pred);
    }

    function applyPreset(p) {
      if (!p) return;
      if (p === 'small') {
        document.getElementById('input-lipid').value = 1.8;
        document.getElementById('input-surf').value = 2.6;
        document.getElementById('input-drug').value = 5.0;
        document.getElementById('input-rpm').value = 18000;
        document.getElementById('input-son').value = 8.0;
        setSurfactant('Poloxamer 188');
      } else if (p === 'highEE') {
        document.getElementById('input-lipid').value = 4.8;
        document.getElementById('input-surf').value = 1.5;
        document.getElementById('input-drug').value = 6.0;
        document.getElementById('input-rpm').value = 12000;
        document.getElementById('input-son').value = 5.0;
        setSurfactant('Poloxamer 188 + Lecithin');
      } else if (p === 'stable') {
        document.getElementById('input-lipid').value = 3.5;
        document.getElementById('input-surf').value = 2.2;
        document.getElementById('input-drug').value = 7.0;
        document.getElementById('input-rpm').value = 16000;
        document.getElementById('input-son').value = 6.0;
        setSurfactant('Poloxamer 188 + Lecithin');
      } else if (p === 'balanced') {
        document.getElementById('input-lipid').value = 3.0;
        document.getElementById('input-surf').value = 1.8;
        document.getElementById('input-drug').value = 8.0;
        document.getElementById('input-rpm').value = 14000;
        document.getElementById('input-son').value = 6.0;
        setSurfactant('Poloxamer 188');
      }
      onParamChange();
    }

    // ==== Radar Chart Rendering ====
    function renderRadar(pred) {
      const svg = document.getElementById('radar-svg');
      const cx = 150, cy = 135, rMax = 100;
      const axes = [
        { label: 'Size (nm)', min: 100, max: 320, val: pred.size, mean: 198.7, invert: true },
        { label: 'PDI (Uniformity)', min: 0.18, max: 0.45, val: pred.pdi, mean: 0.308, invert: true },
        { label: '|Zeta| (Stability)', min: 8, max: 35, val: Math.abs(pred.zeta), mean: 21.0, invert: false },
        { label: 'EE (%)', min: 60, max: 88, val: pred.ee, mean: 76.8, invert: false },
        { label: 'Loading Cap (%)', min: 1.5, max: 10.5, val: pred.loadingCap, mean: 5.96, invert: false }
      ];

      const n = axes.length;
      let html = '';

      // Concentric rings
      for (let level = 1; level <= 4; level++) {
        const r = (rMax / 4) * level;
        let pts = [];
        for (let i = 0; i < n; i++) {
          const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
          pts.push((cx + r * Math.cos(angle)).toFixed(1) + ',' + (cy + r * Math.sin(angle)).toFixed(1));
        }
        html += `<polygon points="${pts.join(' ')}" fill="none" stroke="#1e293b" stroke-width="1"/>`;
      }

      // Axes & labels
      for (let i = 0; i < n; i++) {
        const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
        const x2 = cx + rMax * Math.cos(angle);
        const y2 = cy + rMax * Math.sin(angle);
        html += `<line x1="${cx}" y1="${cy}" x2="${x2}" y2="${y2}" stroke="#334155" stroke-width="1"/>`;

        const lx = cx + (rMax + 22) * Math.cos(angle);
        const ly = cy + (rMax + 14) * Math.sin(angle);
        html += `<text x="${lx}" y="${ly}" fill="#94a3b8" font-size="10" text-anchor="middle" dominant-baseline="middle">${axes[i].label}</text>`;
      }

      // Mean polygon
      let meanPts = [];
      for (let i = 0; i < n; i++) {
        const ax = axes[i];
        let norm = (ax.mean - ax.min) / (ax.max - ax.min);
        if (ax.invert) norm = 1 - norm;
        norm = Math.max(0.1, Math.min(1.0, norm));
        const r = rMax * norm;
        const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
        meanPts.push((cx + r * Math.cos(angle)).toFixed(1) + ',' + (cy + r * Math.sin(angle)).toFixed(1));
      }
      html += `<polygon points="${meanPts.join(' ')}" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3,3"/>`;

      // Current formulation polygon
      let curPts = [];
      for (let i = 0; i < n; i++) {
        const ax = axes[i];
        let norm = (ax.val - ax.min) / (ax.max - ax.min);
        if (ax.invert) norm = 1 - norm;
        norm = Math.max(0.1, Math.min(1.0, norm));
        const r = rMax * norm;
        const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
        curPts.push((cx + r * Math.cos(angle)).toFixed(1) + ',' + (cy + r * Math.sin(angle)).toFixed(1));
      }
      html += `<polygon points="${curPts.join(' ')}" fill="rgba(6, 182, 212, 0.25)" stroke="#06b6d4" stroke-width="2.5"/>`;

      // Current point dots
      for (let i = 0; i < n; i++) {
        const pt = curPts[i].split(',');
        html += `<circle cx="${pt[0]}" cy="${pt[1]}" r="4" fill="#38bdf8" stroke="#083344" stroke-width="1.5"/>`;
      }

      svg.innerHTML = html;
    }

    // ==== Inverse Formulation Search ====
    function updateTargetLabel(type, val) {
      if (type === 'size') document.getElementById('target-size-val').innerText = val + ' nm';
      if (type === 'ee') document.getElementById('target-ee-val').innerText = parseFloat(val).toFixed(1) + ' %';
      if (type === 'pdi') document.getElementById('target-pdi-val').innerText = '≤ ' + parseFloat(val).toFixed(2);
      if (type === 'zeta') {
        const zVal = parseFloat(val).toFixed(1);
        document.getElementById('target-zeta-val').innerText = zVal + ' mV';
      }
    }

    function toggleZetaTarget(enabled) {
      const slider = document.getElementById('inv-zeta');
      const valBadge = document.getElementById('target-zeta-val');
      if (enabled) {
        slider.disabled = false;
        slider.classList.remove('opacity-40');
        valBadge.innerText = parseFloat(slider.value).toFixed(1) + ' mV';
        valBadge.className = 'font-bold text-violet-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800';
      } else {
        slider.disabled = true;
        slider.classList.add('opacity-40');
        valBadge.innerText = 'Flexible / Any';
        valBadge.className = 'font-bold text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800';
      }
    }

    function runInverseOptimization() {
      const targetSize = parseFloat(document.getElementById('inv-size').value);
      const targetEE = parseFloat(document.getElementById('inv-ee').value);
      const targetPdi = parseFloat(document.getElementById('inv-pdi').value);
      const surfPref = document.getElementById('inv-surf-pref').value;
      const zetaEnabled = document.getElementById('inv-zeta-enable').checked;
      const targetZeta = parseFloat(document.getElementById('inv-zeta').value);

      document.getElementById('inv-status').innerText = 'Optimizing across candidate space...';

      const surfOptions = surfPref === 'Any' ? ['Poloxamer 188', 'Tween 80', 'Poloxamer 188 + Lecithin'] : [surfPref];
      const candidates = [];

      const lipidSteps = [1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0];
      const surfSteps = [0.6, 1.0, 1.4, 1.8, 2.2, 2.6, 3.0];
      const drugSteps = [3.0, 5.0, 7.5, 10.0, 12.5, 15.0];
      const rpmSteps = [8000, 10000, 12000, 14000, 16000, 18000, 20000];
      const sonSteps = [2.5, 4.0, 6.0, 8.0, 10.0];

      for (const st of surfOptions) {
        for (const l of lipidSteps) {
          for (const sc of surfSteps) {
            for (const dp of drugSteps) {
              for (const r of rpmSteps) {
                for (const sn of sonSteps) {
                  const pred = predictForward(l, st, sc, dp, r, sn);
                  const sizeDiff = Math.abs(pred.size - targetSize) / targetSize;
                  const eeDiff = Math.abs(pred.ee - targetEE) / targetEE;
                  const pdiPen = pred.pdi > targetPdi ? (pred.pdi - targetPdi) * 3 : 0;

                  let zetaDiff = 0;
                  if (zetaEnabled) {
                    zetaDiff = Math.abs(pred.zeta - targetZeta) / 20.0;
                  }

                  let loss = 0;
                  let matchPct = 0;
                  if (zetaEnabled) {
                    loss = sizeDiff * 0.40 + eeDiff * 0.35 + zetaDiff * 0.20 + pdiPen * 0.05;
                    matchPct = Math.max(0, 100 * (1 - (sizeDiff * 0.40 + eeDiff * 0.35 + zetaDiff * 0.25)));
                  } else {
                    loss = sizeDiff * 0.50 + eeDiff * 0.40 + pdiPen * 0.10;
                    matchPct = Math.max(0, 100 * (1 - (sizeDiff * 0.50 + eeDiff * 0.50)));
                  }

                  candidates.push({
                    lipid: l,
                    surfType: st,
                    surfConc: sc,
                    drugPct: dp,
                    rpm: r,
                    sonication: sn,
                    lipidMass: Math.round(l * 200),
                    drugMass: +(l * 2 * dp).toFixed(2),
                    pred: pred,
                    loss: loss,
                    matchPct: matchPct
                  });
                }
              }
            }
          }
        }
      }

      candidates.sort((a, b) => a.loss - b.loss);
      const top5 = candidates.slice(0, 5);
      renderInverseResults(top5, targetSize, targetEE, targetZeta, zetaEnabled);
      document.getElementById('inv-status').innerText = 'Found ' + top5.length + ' optimal candidates!';
    }

    function renderInverseResults(candidates, targetSize, targetEE, targetZeta, zetaEnabled) {
      const container = document.getElementById('inverse-candidates-list');
      let html = '';

      candidates.forEach((c, i) => {
        const sizeDelta = (c.pred.size - targetSize).toFixed(1);
        const eeDelta = (c.pred.ee - targetEE).toFixed(1);
        const zetaDelta = zetaEnabled ? (c.pred.zeta - targetZeta).toFixed(1) : null;
        const sizeDeltaSign = sizeDelta >= 0 ? '+' : '';
        const eeDeltaSign = eeDelta >= 0 ? '+' : '';
        const zetaDeltaSign = zetaDelta >= 0 ? '+' : '';

        const zetaStabilityBadge = Math.abs(c.pred.zeta) >= 28
          ? '<span class="px-2 py-0.5 rounded bg-emerald-950/80 border border-emerald-800 text-emerald-400 text-[10px] font-semibold">⚡ Highly Stable Colloid</span>'
          : (Math.abs(c.pred.zeta) >= 18
            ? '<span class="px-2 py-0.5 rounded bg-violet-950/80 border border-violet-800 text-violet-300 text-[10px] font-semibold">🛡️ Moderate Stability</span>'
            : '<span class="px-2 py-0.5 rounded bg-amber-950/80 border border-amber-800 text-amber-300 text-[10px] font-semibold">⚠️ Low Potential</span>');

        html += `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg hover:border-cyan-500/50 transition">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-800 pb-3 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-cyan-950 text-cyan-400 border border-cyan-800 flex items-center justify-center font-bold text-sm">#${i + 1}</span>
              <div>
                <h4 class="text-sm font-bold text-white flex items-center gap-2">Candidate Recipe #${i + 1} (${c.surfType})</h4>
                <p class="text-[11px] text-slate-400">
                  Target Size: <span class="text-cyan-300 font-medium">${targetSize} nm</span> |
                  EE: <span class="text-emerald-300 font-medium">${targetEE}%</span>
                  ${zetaEnabled ? ` | Target Zeta: <span class="text-violet-300 font-medium">${targetZeta.toFixed(1)} mV</span>` : ''}
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              ${zetaStabilityBadge}
              <span class="px-2.5 py-1 rounded-md bg-emerald-950/80 border border-emerald-800 text-emerald-400 text-xs font-bold font-mono">${c.matchPct.toFixed(1)}% Match</span>
              <button onclick='openProtocolModal(${JSON.stringify(c)})' class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 flex items-center gap-1.5">
                <span>📋</span> View Wet‑Lab Card
              </button>
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-6 gap-3 text-xs mb-3">
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">Lipid Conc:</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">${c.lipid}% w/v</span>
              <span class="text-[10px] text-slate-500 block">(${c.lipidMass} mg / 20mL)</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">Surfactant:</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">${c.surfConc}% w/v</span>
              <span class="text-[10px] text-slate-500 block truncate">${c.surfType}</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">Drug Loading:</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">${c.drugPct}%</span>
              <span class="text-[10px] text-slate-500 block">(${c.drugMass} mg drug)</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">Homogenization:</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">${c.rpm.toLocaleString()} rpm</span>
              <span class="text-[10px] text-slate-500 block">Hot High‑Shear</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">Sonication:</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">${c.sonication} min</span>
              <span class="text-[10px] text-slate-500 block">20 kHz probe</span>
            </div>
            <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
              <span class="text-slate-400 block text-[10px]">PDI Uniformity:</span>
              <span class="text-emerald-400 font-bold font-mono text-sm">${c.pred.pdi.toFixed(3)}</span>
              <span class="text-[10px] text-slate-500 block">Monodisperse</span>
            </div>
          </div>

          <!-- Predicted CQAs vs Objectives -->
          <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80 flex flex-wrap items-center justify-between text-xs gap-2">
            <div class="flex items-center flex-wrap gap-4">
              <span>Predicted Size: <strong class="text-white font-mono">${c.pred.size.toFixed(1)} nm</strong> <span class="text-slate-400 text-[11px]">(${sizeDeltaSign}${sizeDelta} nm)</span></span>
              <span>Predicted EE: <strong class="text-white font-mono">${c.pred.ee.toFixed(1)}%</strong> <span class="text-slate-400 text-[11px]">(${eeDeltaSign}${eeDelta}%)</span></span>
              <span>Predicted Zeta: <strong class="text-violet-300 font-mono">${c.pred.zeta.toFixed(1)} mV</strong> ${zetaEnabled ? `<span class="text-violet-400 text-[11px]">(${zetaDeltaSign}${zetaDelta} mV)</span>` : ''}</span>
              <span>Loading Cap: <strong class="text-white font-mono">${c.pred.loadingCap.toFixed(2)}%</strong></span>
            </div>
            <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Ready for Laboratory Synthesis
            </span>
          </div>
        </div>
        `;
      });

      container.innerHTML = html;
    }

    // ==== Protocol Modal ====
    function openProtocolModal(c) {
      const modal = document.getElementById('protocol-modal');
      const content = document.getElementById('protocol-content');

      content.innerHTML = `
        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1.5 font-mono text-xs">
          <div class="text-cyan-400 font-bold text-sm mb-1">FORMULATION RUN SPECIFICATION CARD</div>
          <div><strong class="text-slate-400">Lipid Matrix:</strong> Glyceryl behenate (Compritol 888 ATO) = ${c.lipidMass} mg (${c.lipid}% w/v)</div>
          <div><strong class="text-slate-400">Drug:</strong> Model Lipophilic Active = ${c.drugMass} mg (${c.drugPct}% of lipid)</div>
          <div><strong class="text-slate-400">Surfactant:</strong> ${c.surfType} = ${(c.surfConc * 200).toFixed(0)} mg (${c.surfConc}% w/v in 20 mL)</div>
          <div><strong class="text-slate-400">Aqueous Phase:</strong> Double‑distilled Water = 20.0 mL</div>
        </div>

        <div class="space-y-2 text-xs">
          <div class="font-bold text-slate-200">Equipment &amp; Process Instructions:</div>
          <ol class="list-decimal list-inside space-y-1.5 text-slate-300">
            <li>Weigh <strong>${c.lipidMass} mg</strong> Compritol 888 ATO and <strong>${c.drugMass} mg</strong> drug into a 50 mL glass beaker. Heat on a hot‑plate water bath at <strong>75 °C</strong> until melt is clear and homogeneous.</li>
            <li>Dissolve <strong>${(c.surfConc * 200).toFixed(0)} mg</strong> ${c.surfType} in 20 mL deionized water at 75 °C.</li>
            <li>Add hot surfactant phase dropwise into molten lipid under magnetic stirring (1,000 rpm, 3 min) to form a coarse primary oil‑in‑water emulsion.</li>
            <li>Immediately transfer to high‑shear homogenizer at <strong>${c.rpm.toLocaleString()} rpm</strong> for 5 min at 75 °C.</li>
            <li>Probe‑sonicate for <strong>${c.sonication} minutes</strong> (40 % amplitude, 10 s ON / 5 s OFF) to prevent overheating.</li>
            <li>Rapidly cool dispersion in an ice bath (4 °C) for 15 min under gentle stirring to solidify nanoparticles.</li>
          </ol>
        </div>

        <div class="p-3 bg-emerald-950/40 border border-emerald-800/80 rounded-xl text-xs space-y-1">
          <span class="font-bold text-emerald-400 block">Expected Quality Check / Acceptance Criteria:</span>
          <div class="flex justify-between text-slate-300">
            <span>Predicted Size: <strong>${c.pred.size.toFixed(1)} nm</strong> (±10 nm)</span>
            <span>Predicted EE: <strong>${c.pred.ee.toFixed(1)}%</strong> (±3%)</span>
            <span>Predicted Zeta: <strong>${c.pred.zeta.toFixed(1)} mV</strong> (±2.5 mV)</span>
            <span>Predicted PDI: <strong>${c.pred.pdi.toFixed(3)}</strong></span>
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
    }

    function closeProtocolModal() {
      document.getElementById('protocol-modal').classList.add('hidden');
    }

    // ==== Parity Plot ====
    function renderParityPlot(targetKey) {
      const svg = document.getElementById('parity-svg');
      const w = 400, h = 340, pad = 50;
      const actuals = records.map(r => r[targetKey]);
      const minVal = Math.min(...actuals) * 0.95;
      const maxVal = Math.max(...actuals) * 1.05;

      const scale = v => pad + ((v - minVal) / (maxVal - minVal)) * (w - 2 * pad);
      const scaleY = v => (h - pad) - ((v - minVal) / (maxVal - minVal)) * (h - 2 * pad);

      let html = '';

      // Axes
      html += `<line x1="${pad}" y1="${h - pad}" x2="${w - pad}" y2="${h - pad}" stroke="#334155" stroke-width="1.5"/>`;
      html += `<line x1="${pad}" y1="${pad}" x2="${pad}" y2="${h - pad}" stroke="#334155" stroke-width="1.5"/>`;

      // 1:1 diagonal
      const x1 = scale(minVal), y1 = scaleY(minVal);
      const x2 = scale(maxVal), y2 = scaleY(maxVal);
      html += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="4,4"/>`;

      // Data points
      records.forEach(r => {
        const pred = predictForward(r.lipid, r.surfType, r.surfConc, r.drugPct, r.rpm, r.sonication)[targetKey];
        const px = scale(r[targetKey]);
        const py = scaleY(pred);
        let color = '#38bdf8';
        if (r.surfType === 'Tween 80') color = '#a78bfa';
        if (r.surfType === 'Poloxamer 188 + Lecithin') color = '#34d399';
        html += `<circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="3.5" fill="${color}" opacity="0.8"/>`;
      });

      // Axis labels
      html += `<text x="${w / 2}" y="${h - 15}" fill="#94a3b8" font-size="11" text-anchor="middle">Observed Experimental Value</text>`;
      html += `<text x="18" y="${h / 2}" fill="#94a3b8" font-size="11" text-anchor="middle" transform="rotate(-90 18 ${h / 2})">AI Model Predicted Value</text>`;

      // R² annotation (placeholder, replace with real metrics)
      const r2Val = (metricsData.ridge && metricsData.ridge[targetKey] && metricsData.ridge[targetKey].r2) ? metricsData.ridge[targetKey].r2.toFixed(4) : 'N/A';
      html += `<rect x="${pad + 10}" y="${pad + 10}" width="110" height="26" rx="6" fill="#0f172a" stroke="#1e293b"/>`;
      html += `<text x="${pad + 20}" y="${pad + 27}" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">R² = ${r2Val}</text>`;

      svg.innerHTML = html;
    }

    // ==== Metrics Table ====
    function populateMetricsTable() {
      const tbody = document.getElementById('metrics-table-body');
      const targets = [
        { key: 'size', name: 'Particle Size (nm)', range: '104 - 321 nm' },
        { key: 'pdi', name: 'Polydispersity Index (PDI)', range: '0.18 - 0.47' },
        { key: 'zeta', name: 'Zeta Potential (mV)', range: '-34.5 to -8.4 mV' },
        { key: 'ee', name: 'Encapsulation Efficiency (%)', range: '60.3 - 87.6 %' },
        { key: 'loadingCap', name: 'Loading Capacity (%)', range: '1.67 - 10.46 %' }
      ];

      let html = '';
      targets.forEach(t => {
        const ridge = metricsData.ridge[t.key] || {};
        const cv = metricsData.ridgeCV[t.key] || {};
        const rf = metricsData.rf[t.key] || {};

        html += `
        <tr class="hover:bg-slate-800/50 transition">
          <td class="py-3 px-3 font-semibold text-white">${t.name}</td>
          <td class="py-3 px-3 text-slate-400">${t.range}</td>
          <td class="py-3 px-3 text-cyan-300">${ridge.r2 ? ridge.r2.toFixed(4) : 'N/A'}</td>
          <td class="py-3 px-3 text-emerald-400 font-bold">${cv.r2 ? cv.r2.toFixed(4) : 'N/A'}</td>
          <td class="py-3 px-3 text-slate-300">${cv.mae ? cv.mae.toFixed(4) : 'N/A'}</td>
          <td class="py-3 px-3 text-slate-300">${cv.rmse ? cv.rmse.toFixed(4) : 'N/A'}</td>
          <td class="py-3 px-3 text-violet-300">${rf.r2 ? rf.r2.toFixed(4) : 'N/A'}</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800 text-[10px] font-sans">Validated</span></td>
        </tr>`;
      });
      tbody.innerHTML = html;
    }

    // ==== Feature Weights ====
    function populateFeatureWeights() {
      const container = document.getElementById('feature-weights-container');
      const weights = (metricsData.featureWeights && metricsData.featureWeights['size']) ? metricsData.featureWeights['size'].slice(0, 6) : [];
      let html = '';

      weights.forEach(w => {
        const pct = Math.min(100, Math.round((w.absWeight / weights[0].absWeight) * 100));
        html += `
        <div class="space-y-1 text-xs">
          <div class="flex justify-between text-slate-300">
            <span class="font-medium">${w.name}</span>
            <span class="text-cyan-400 font-mono">${w.weight > 0 ? '+' : ''}${w.weight.toFixed(2)}</span>
          </div>
          <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
            <div class="bg-gradient-to-r from-cyan-500 to-blue-600 h-full rounded-full" style="width: ${pct}%;"></div>
          </div>
        </div>`;
      });
      container.innerHTML = html;
    }

    // ==== Dataset Table ====
    function populateDatasetTable() {
      filterDatasetTable();
    }

    function filterDatasetTable() {
      const q = document.getElementById('dataset-search').value.toLowerCase();
      const stFilter = document.getElementById('dataset-surf-filter').value;
      const tbody = document.getElementById('dataset-table-body');

      const filtered = records.filter(r => {
        const matchesQ = r.id.toLowerCase().includes(q);
        const matchesSt = stFilter === 'All' || r.surfType === stFilter;
        return matchesQ && matchesSt;
      });

      let html = '';
      filtered.forEach(r => {
        html += `
        <tr class="hover:bg-slate-800/40 transition">
          <td class="py-2 px-3 text-cyan-400 font-bold">${r.id}</td>
          <td class="py-2 px-3">${r.lipid}</td>
          <td class="py-2 px-3 text-slate-300 truncate max-w-[130px]">${r.surfType}</td>
          <td class="py-2 px-3">${r.surfConc}</td>
          <td class="py-2 px-3">${r.drugPct}</td>
          <td class="py-2 px-3">${r.rpm.toLocaleString()}</td>
          <td class="py-2 px-3">${r.sonication}</td>
          <td class="py-2 px-3 text-white font-bold">${r.size}</td>
          <td class="py-2 px-3 text-emerald-400">${r.pdi}</td>
          <td class="py-2 px-3 text-violet-400">${r.zeta}</td>
          <td class="py-2 px-3 text-amber-400">${r.ee}</td>
          <td class="py-2 px-3 text-sky-400">${r.loadingCap.toFixed(2)}</td>
        </tr>`;
      });

      tbody.innerHTML = html;
      document.getElementById('dataset-row-count').innerText = 'Showing ' + filtered.length + ' of ' + records.length + ' formulations';
    }

    // ==== CSV Export ====
    function exportCSV() {
      let csv = 'ID,Glyceryl behenate (% w/v),Surfactant system,Surfactant (% w/v),Drug (% of lipid),Homogenization (rpm),Sonication (min),Lipid mass (mg/20 mL),Drug mass (mg),Size (nm),PDI,Zeta potential (mV),EE (%),Loading capacity (%)\\n';
      records.forEach(r => {
        csv += [r.id, r.lipid, r.surfType, r.surfConc, r.drugPct, r.rpm, r.sonication, r.lipidMass, r.drugMass, r.size, r.pdi, r.zeta, r.ee, r.loadingCap].join(',') + '\\n';
      });
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'nanoparticle_dataset_120.csv';
      a.click();
    }

    // ==== Tab Navigation ====
    function switchTab(tabId) {
      ['forward', 'inverse', 'analytics', 'dataset', 'concept'].forEach(t => {
        const view = document.getElementById('view-' + t);
        const btn = document.getElementById('tab-' + t);
        if (t === tabId) {
          view.classList.remove('hidden');
          btn.className = 'tab-btn active px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-300 hover:text-white';
        } else {
          view.classList.add('hidden');
          btn.className = 'tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-slate-400 hover:text-white';
        }
      });

      if (tabId === 'analytics') {
        renderParityPlot('size');
      }
    }

    // ==== Initialization on load ====
    window.onload = function() {
      onParamChange();
      runInverseOptimization();
      populateMetricsTable();
      populateFeatureWeights();
      populateDatasetTable();
      renderParityPlot('size');
    };
  </script>
</body>
</html>